
@article{dahlquist_international_2013,
	title = {International {Bond} {Risk} {Premia}},
	volume = {90},
	issn = {0022-1996},
	url = {https://www.sciencedirect.com/science/article/pii/S0022199612002024},
	doi = {10.1016/j.jinteco.2012.11.008},
	abstract = {We find evidence for time-varying risk premia across international bond markets. Local and global factors jointly predict returns. The global factor is closely linked to US bond risk premia and international business cycles. Movements in the global factor seem to drive risk premia and expected short-term interest rates in opposite directions. We consider an affine term-structure model in which risk premia are driven by one local and one global factor. Shocks to these factors account for only a small fraction of yield variance and the cross-section of yields conveys little information about the factors. Finally, correlations between international bond risk premia have increased over time, suggesting an increase in integration between markets.},
	number = {1},
	urldate = {2025-11-20},
	journal = {Journal of International Economics},
	author = {Dahlquist, Magnus and Hasseltoft, Henrik},
	month = may,
	year = {2013},
	keywords = {Affine model, Local and global factors, Time-varying risk premia},
	pages = {17--32},
	file = {ScienceDirect Full Text PDF:/Users/jan/Zotero/storage/8ND8LJ6P/Dahlquist and Hasseltoft - 2013 - International Bond Risk Premia.pdf:application/pdf;ScienceDirect Snapshot:/Users/jan/Zotero/storage/25M2PXSK/S0022199612002024.html:text/html},
}

